{
  "$comment": "Centralized heuristic constants for all brand-ai-readiness-audit domain skills. All skills MUST import these values rather than hard-coding thresholds inline.",
  "schema_version": "1.0.0",

  "http": {
    "request_timeout_seconds": 8.0,
    "connect_timeout_seconds": 5.0,
    "rate_limit_seconds_per_host": 1.0,
    "max_retries": 2,
    "retry_backoff_factor": 0.5,
    "user_agent": "BrandAIReadinessAuditBot/1.0 (+https://github.com/brand-ai-readiness-audit)",
    "max_response_size_bytes": 5242880,
    "default_headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.9",
      "Accept-Encoding": "gzip, deflate"
    }
  },

  "crawl": {
    "max_pages": 15,
    "max_depth": 3,
    "allowed_schemes": ["http", "https"],
    "sitemap_max_urls": 500,
    "sitemap_max_doc_bytes": 1048576,
    "sitemap_max_cumulative_bytes": 5242880,
    "sitemap_max_docs": 25,
    "max_links_per_page": 200,
    "max_queue_size": 500,
    "disallow_extensions": [
      ".pdf", ".jpg", ".jpeg", ".png", ".gif", ".svg", ".webp",
      ".mp4", ".mp3", ".zip", ".gz", ".tar", ".woff", ".woff2",
      ".ttf", ".eot", ".ico", ".css", ".js"
    ]
  },

  "render": {
    "text_blanking_ratio_threshold": 0.15,
    "csr_text_ratio_warning_$comment": "Set to 0.30 (not 0.50) to prevent false-positive CR-004 warnings on markup-heavy static/legacy pages (e.g. 3_legacy.html fixture with text ratio ~0.44 has zero CSR, but would trigger under 0.50). 0.30 cleanly isolates real SPA shells like 1_spa.html (ratio 0.02).",
    "csr_text_ratio_warning": 0.30,
    "playwright_wait_ms": 3000,
    "playwright_viewport_width": 1280,
    "playwright_viewport_height": 800,
    "playwright_timeout_ms": 15000,
    "max_browser_requests_per_page": 150,
    "max_browser_redirects": 5
  },

  "robots": {
    "known_ai_crawlers": [
      "GPTBot",
      "ChatGPT-User",
      "Google-Extended",
      "CCBot",
      "anthropic-ai",
      "Claude-Web",
      "PerplexityBot",
      "Amazonbot",
      "FacebookBot",
      "Applebot-Extended",
      "YouBot",
      "Omgilibot",
      "Diffbot",
      "Bytespider"
    ]
  },

  "structured_data": {
    "min_jsonld_fields_organization": 4,
    "min_jsonld_fields_product": 3,
    "freshness_max_age_days": 180,
    "freshness_stale_age_days": 365,
    "image_text_ratio_threshold": 0.40,
    "pdf_text_density_threshold": 50
  },

  "entity": {
    "nap_consistency_min_ratio": 0.80,
    "sameas_min_external_links": 1,
    "max_claim_verification_urls": 3,
    "brand_name_max_variations": 2,
    "address_similarity_threshold": 0.85,
    "phone_normalization_pattern": "^\\+?[0-9\\s\\-\\(\\)]{7,20}$"
  },

  "engagement": {
    "overlay_coverage_threshold": 0.60,
    "above_fold_h1_required": true,
    "nav_links_min_count": 3,
    "cls_threshold": 0.10,
    "interstitial_z_index_threshold": 100,
    "interstitial_delay_ms_threshold": 2000,
    "viewport_stable_wait_ms": 1500,
    "broken_link_sample_size": 25,
    "broken_link_ratio_threshold": 0.05,
    "search_page_threshold": 30,
    "breadcrumb_min_depth": 2
  },

  "proactive": {
    "heading_id_ratio_threshold": 0.50
  }
}
